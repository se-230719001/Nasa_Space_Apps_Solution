; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MoonMinds"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://cb4n5tj35s5r1"

[autoload]

Events="*res://scenes/core/events.gd"
Colony="*res://scenes/core/colony.gd"
Music="*res://scenes/audio/music_director.gd"
Sfx="*res://scenes/audio/sfx_director.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[gui]

theme/custom="res://ui/theme/moonminds_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
